# ── PLXYGROUND Backend Environment Variables ──
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Server
PORT=3011
NODE_ENV=development

# ── Database (Supabase) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Auth ──
JWT_SECRET=your-strong-random-secret-min-32-chars
JWT_EXPIRES_IN=7d

# ── CORS (comma-separated origins) ──
CORS_ORIGIN=http://localhost:19006,http://localhost:3012,http://localhost:8081

# ── Email ──
# Set LOCAL_STUB_EMAIL=true to log emails to console instead of sending (dev)
LOCAL_STUB_EMAIL=true
# RESEND_API_KEY=re_your_resend_api_key
# RESEND_FROM_EMAIL=noreply@plxyground.com

# ── Feature Toggles ──
MOCK_ANALYTICS=false
ADMIN_AUTO_REFRESH_INTERVAL=30000

# ── Seed credentials – required when running seeds/seed.js ──
SEED_ADMIN_PASSWORD=change-me-strong-admin-password
SEED_USER_PASSWORD=change-me-strong-user-password
