# ── PLXYGROUND Frontend Environment Variables ──
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# EXPO_PUBLIC_ prefix is required — these values are inlined at build time.
# See: https://docs.expo.dev/guides/environment-variables/

# Backend API base URL (no trailing slash)
# Development:  http://localhost:3011
# Staging:      https://api.staging.plxyground.com
# Production:   https://api.plxyground.com
EXPO_PUBLIC_API_BASE_URL=http://localhost:3011
